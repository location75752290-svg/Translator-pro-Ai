# Declare default behavior to handle line endings automatically
* text=auto

# Explicitly declare binary files that should not be modified by text conversion
*.jar binary -text
*.png binary -text
*.jpg binary -text
*.jpeg binary -text
*.gif binary -text
*.ico binary -text
gradle/wrapper/gradle-wrapper.jar binary -text

# Ensure gradlew has LF line endings
gradlew text eol=lf
# Ensure gradlew.bat has CRLF line endings
gradlew.bat text eol=crlf
